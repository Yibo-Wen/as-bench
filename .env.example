# Copy to .env (gitignored) and fill in only what you use.
# evals/run.py passes this file to Harbor and checks, before launching, that every
# preset you selected has its key. Presets reference keys as ${VAR} (evals/agents.toml).

# --- Anthropic: claude-* presets (Claude Code), mswea-claude-* ---------------------
ANTHROPIC_API_KEY=
# ...or a Claude subscription token from `claude setup-token` (Claude Code only):
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_FORCE_OAUTH=1

# --- OpenAI: gpt-* presets (Codex), mswea-gpt-* ----------------------------------
OPENAI_API_KEY=

# --- xAI: grok-4.7, grok-4.6 (Grok Build) ----------------------------------------
XAI_API_KEY=

# --- Google: gemini-* presets (mini-SWE-agent) -----------------------------------
GEMINI_API_KEY=

# --- DeepSeek: deepseek-* presets (Codex -> api.deepseek.com) ---------------------
DEEPSEEK_API_KEY=

# --- Z.ai: glm-5.3 (Claude Code -> api.z.ai/api/anthropic) -----------------------
ZAI_API_KEY=

# --- Moonshot: kimi-k3 (Claude Code -> api.moonshot.ai/anthropic) ----------------
MOONSHOT_API_KEY=

# --- OpenRouter: small open-weight presets (qwen3.8-27b, glm-5.3-flash, minimax-m3)
OPENROUTER_API_KEY=

# --- Cloud sandboxes (only for --env modal / --env daytona) ----------------------
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# DAYTONA_API_KEY=
